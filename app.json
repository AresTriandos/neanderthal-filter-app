{
  "expo": {
    "name": "NeanderthalFilter",
    "slug": "neanderthal-filter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neanderthalfilter.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Neanderthal Filter uses the camera so you can take a selfie for analysis.",
        "NSPhotoLibraryUsageDescription": "Neanderthal Filter lets you choose a selfie from your library for analysis."
      }
    },
    "android": {
      "package": "com.neanderthalfilter.app",
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "cae276bd-dedf-4b8e-b81d-9f18049a5324"
      }
    },
    "owner": "ares.triandos"
  }
}
